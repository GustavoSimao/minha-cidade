{
  "$schema": "https://app.kilo.ai/config.json",

  // Config do projeto minha-cidade. Complementa o global (~/.config/kilo/kilo.jsonc):
  // deep-merge, projeto vence no mesmo nome de chave. Regra de avaliacao: topo para
  // baixo, a ULTIMA regra que casa vence — por isso o fallback "*" vem primeiro e os
  // allows depois. Referencia: .kilo/plans/1791829052316-kilo-permissoes-e-agents.md.

  "permission": {
    "read": "allow",

    // Edicao livre no repo, exceto segredos: a service_role key vive em
    // apps/web/.env.local (gitignored).
    "edit": {
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "*": "allow"
    },

    "external_directory": {
      "C:\\projetos\\*": "allow",
      "C:\\Users\\gusta\\AppData\\Local\\Temp\\*": "allow",
      "C:\\Users\\gusta\\.config\\kilo\\*": "allow"
    },

    // Rede sempre confirmada: um curl/fetch pode vazar segredo do .env.local.
    "webfetch": "ask",
    "websearch": "ask",

    // Subagentes do time (.kilo/agents) e skills do repo fazem parte do fluxo
    // spec -> codigo -> revisao.
    "task": "allow",
    "skill": "allow",

    "bash": {
      // Fallback ask primeiro; os allows abaixo venceem por virem depois.
      // Destrutivos (git commit/push/reset/clean, docker down/prune/exec,
      // supabase remoto) ficam no fallback.
      "*": "ask",

      // build/teste do apps/web (Etapas A-C do plano de design)
      "npm *": "allow",
      "node *": "allow",
      "npx *": "allow",

      // scanner zero-dependencia de design (skill avoid-ai-design)
      "node .kilo/skills/avoid-ai-design/scripts/detect.mjs*": "allow",

      // git: somente leitura automatica
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git ls-files*": "allow",
      "git rev-parse*": "allow",
      "git remote*": "allow",

      // Supabase LOCAL liberado (start/stop/status/db reset) para o ciclo
      // migration -> db reset -> seed do plano. Padroes sem colisao de nome
      // vencem o "supabase *": "ask" do global (ultima regra que casa vence).
      // Supabase REMOTO (db push, link, secrets set) continua no fallback ask.
      "supabase status": "allow",
      "supabase status *": "allow",
      "supabase start": "allow",
      "supabase start *": "allow",
      "supabase stop": "allow",
      "supabase stop *": "allow",
      "supabase db reset": "allow",
      "supabase db reset *": "allow",

      // Docker: inspecao livre; down/stop/rm/prune/exec ficam no fallback ask.
      "docker ps*": "allow",
      "docker images*": "allow",
      "docker compose ps*": "allow",
      "docker compose logs*": "allow",
      "docker compose config*": "allow",
      "docker compose up*": "allow",

      // utilitarios de leitura do PowerShell
      "Get-ChildItem *": "allow",
      "Get-Content *": "allow",
      "Get-Location *": "allow",
      "Test-Path *": "allow",
      "Get-Command *": "allow",

      // destrutivos explicitos (reforcam o fallback e documentam a intencao)
      "Remove-Item *": "ask",
      "git clean*": "ask",
      "git reset*": "ask"
    }
  }
}

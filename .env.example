# Supabase — projeto Minha Cidade
# Copiar para .env.local em apps/web e preencher com os valores do painel Supabase
# (Project Settings -> API). NUNCA versionar .env.local.

# Públicas (seguro expor no browser, protegidas por RLS)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Privadas (somente servidor; nunca prefixar com NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app (usada em auth redirect e metadata de e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Conexão direta ao Postgres (usada por migrations/seed locais e pelo repo Python,
# sempre pelo pooler Supavisor na porta 6543)
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-SA-REGIAO.pooler.supabase.com:6543/postgres
